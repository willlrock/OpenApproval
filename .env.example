APP_NAME="TEG Approval Bot"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8000

# Retired Task Tracker module: keep disabled in product environments.
TRACKER_ENABLED=false

# Port the app will be available on (host machine)
APP_PORT=8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info
LOG_DAILY_DAYS=14
LOG_SLOW_REQUEST_MS=2000
APP_RELEASE=

# Optional error monitoring. Empty DSN disables sending; use a dedicated Sentry project.
SENTRY_LARAVEL_DSN=
SENTRY_FRONTEND_DSN=
SENTRY_ENVIRONMENT="${APP_ENV}"
SENTRY_RELEASE="${APP_RELEASE}"

# Database (Docker uses service name "postgres" as host)
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=teg_bot
DB_USERNAME=postgres
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
SOFFICE_BINARY=soffice
PDFUNITE_BINARY=pdfunite
DOCUMENT_CONVERSION_TIMEOUT=120
MANAGEMENT_DOCUMENT_MAX_UPLOAD_KB=20480
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=log

VITE_APP_NAME="${APP_NAME}"

# Telegram bot
TELEGRAM_TOKEN=
TELEGRAM_WEBHOOK_URL=
TELEGRAM_WEBHOOK_SECRET=
# Only the actual reverse proxy addresses/CIDRs, e.g. 127.0.0.1,::1.
TRUSTED_PROXIES=
# Optional channel invitation shown after registration approval.
TELEGRAM_CHANNEL_INVITE_URL=

# Google Sheets (optional)
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SHEETS_SHEET_NAME=Лист1
GOOGLE_APPLICATION_CREDENTIALS=

# Signature cleaner (registration step 3). Requires python3 + opencv-python + numpy.
# If the binary or the libraries are missing, the bot falls back to the raw photo.
SIGNATURE_PYTHON_BIN=python3
SIGNATURE_CLEAN_TIMEOUT=30

# PDF request import
PDFTOTEXT_BINARY=pdftotext
PDF_IMPORT_TIMEOUT=30
PDF_IMPORT_MAX_FILE_SIZE=10485760

# Production HTTPS: explicitly set SESSION_SECURE_COOKIE=true.
